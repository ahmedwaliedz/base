<?php

namespace Database\Seeders;

use App\Models\Country;
use Illuminate\Database\Console\Seeds\WithoutModelEvents;
use Illuminate\Database\Seeder;
use File ;
class CountryTableSeeder extends Seeder
{
    /**
     * Run the database seeds.
     */
    public function run(): void
    {
        $jsonPath = database_path('json/arab_countries.json');
        $countries = json_decode(File::get($jsonPath), true);

        foreach ($countries as $countryData) {
            // Create the main country record
            $country = Country::create([
                'code' => $countryData['code'],
                'flag' => $countryData['flag'],
            ]);

            // Create translations for English and Arabic names
            $country->translateOrNew('en')->name = $countryData['en'];
            $country->translateOrNew('ar')->name = $countryData['ar'];
            $country->save();
        }
    }
}
