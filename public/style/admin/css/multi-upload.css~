#drop-area {
    border: 2px dashed #ddd;
    border-radius: 8px;
    padding: 1.5rem;
    text-align: center;
    cursor: pointer;
    transition: background 0.3s;
}
#drop-area.hover {
    background: rgba(93,46,140,0.1);
}
#drop-area p {
    margin: 0;
    color: #ddd;
}
#gallery {
    display: flex;
    flex-wrap: wrap;
    margin-top: 1rem;
    gap: 1rem;
}
#gallery .preview {
    position: relative;
    width: 80px;
    height: 80px;
    border: 1px solid #ccc;
    border-radius: 4px;
    overflow: hidden;
}
#gallery .preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}
#gallery .preview .remove {
    position: absolute;
    top: 2px;
    left: 2px;
    background: #f00;
    color: #fff;
    border: none;
    border-radius: 50%;
    width: 20px;
    height: 20px;
    cursor: pointer;
    font-size: 14px;
    line-height: 18px;
}
