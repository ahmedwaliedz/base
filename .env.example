APP_NAME=Laravel
APP_ENV=production
APP_KEY=
X_API_KEY=
APP_DEBUG=false
APP_LOG_LEVEL=debug
APP_URL=https://your-domain.com

DEBUGBAR_ENABLED=false
NODE_HOST=127.0.0.1
NODE_PORT=3030
# test - live (str)
NODE_MODE=test

DB_CONNECTION=mysql
# IMPORTANT: Set DB_HOST to your InfinityFree MySQL hostname from the hosting panel (e.g. sqlXXX.infinityfree.com)
# DO NOT use 127.0.0.1 or localhost on production.
DB_HOST=your_infinityfree_mysql_host
DB_PORT=3306
DB_DATABASE=your_infinityfree_database
DB_USERNAME=your_infinityfree_username
DB_PASSWORD=your_infinityfree_password

BROADCAST_DRIVER=log
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=sendmail
MAIL_HOST=mail.smtp2go.com
MAIL_PORT=80
MAIL_FROM_ADDRESS=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=
MAIL_ENCRYPTION=tls

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

JWT_SECRET=
RESET_CODE=1122

FCM_SERVER_KEY=

# Emergency cache clear token (generate a random string locally, set it here)
# Used by public/server-maintenance-clear-cache.php
MAINTENANCE_CLEAR_TOKEN=
